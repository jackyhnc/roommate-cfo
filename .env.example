# Grok (https://console.x.ai). Without a key the agent uses hardcoded demo fallbacks.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# "mock" mints our own RLUSD-coded token (always works).
# "ripple" uses Ripple's real testnet RLUSD; setup tells you where to send faucet funds.
RLUSD_MODE=mock

# The house group chat, as seen from the CFO's Apple ID. Run `npm start` without these to list chats.
GROUP_CHAT_NAME=
GROUP_CHAT_ID=

# Each roommate's iMessage handle (phone or Apple ID email), so the CFO knows who approved.
CALVIN_HANDLE=
EFORD_HANDLE=
RYAN_HANDLE=

# Shopping agent (Stagehand + Grok driving Chrome). "place" buys for real; "stop" halts before the final button.
CHECKOUT=place
SHOPPER_MAX_STEPS=40
